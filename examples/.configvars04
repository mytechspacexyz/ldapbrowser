# FoxPass example:

export LDAP_SERVER_HOSTNAME=""
export LDAP_SERVER_HOSTNAMES=(
                              "ldap.foxpass.com" 
                             )
export LDAP_DIRECTORY_TYPE="FOXPASS"
export LDAP_BIND_ACCOUNT="ldapreader"
export LDAP_BIND_ACCOUNT_ATTR="uid"
export LDAP_BIND_PASSWORD="bm9pdTg0NTNoZEVF"
export LDAP_SUFFIX="dc=<your foxpass org here>,dc=com"
export LDAP_BASE_DN="dc=<your foxpass org here>,dc=com"
export LDAP_USERS_DN="ou=people"
export LDAP_CURRENT_DN=${LDAP_BASE_DN}
export LDAP_SELECTED_DN=${LDAP_CURRENT_DN}
export LDAP_SNAPSHOTS_DIR="${BASHAPP_DIR}/data"
export LDAP_SNAPSHOTS_FILE="${LDAP_SNAPSHOTS_DIR}/ldapbrowser-snapshots"
export CACERT="${BASHAPP_DIR}/${BASHAPP_CONFDIR}/foxpass-ldap-ca.pem"
